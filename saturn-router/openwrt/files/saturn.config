# Saturn Configuration
# Network AI Service Registry - Multiple services with mDNS discovery
#
# Each 'config service' section creates a separate mDNS announcement.
# Cloud services have the router manage credentials and call remote APIs.
# Network services just advertise the location of a local/LAN service.
#
# Fields:
#   deployment    - 'cloud' (remote API) or 'network' (local/LAN service)
#   api_type      - 'openai' or 'ollama' (API compatibility format)
#   base_url      - Full base URL of the API (e.g., https://api.openai.com/v1)
#   api_key       - API key (required for cloud deployments)
#   advertise_port - Custom port for mDNS advertisement (cloud only, default: auto from 8400)
#   host/port     - Backend location (required for network deployments)
#   ephemeral_keys - Enable rotating keys (for OpenRouter provisioning API)
#   key_endpoint  - Endpoint for generating ephemeral keys
#
# Quick Start:
#   uci add saturn service
#   uci set saturn.@service[-1].name='my-openrouter'
#   uci set saturn.@service[-1].deployment='cloud'
#   uci set saturn.@service[-1].api_type='openai'
#   uci set saturn.@service[-1].base_url='https://openrouter.ai/api/v1'
#   uci set saturn.@service[-1].api_key='YOUR_API_KEY'
#   uci set saturn.@service[-1].enabled='1'
#   uci commit saturn
#   /etc/init.d/saturn start

config saturn 'main'
	# Enable/disable all Saturn services
	option enabled '1'

	# Health check interval in seconds (applies to all services)
	option health_interval '30'

	# Base port for mDNS advertisement (cloud services use this, network services use backend port)
	# Each cloud service increments from this base to avoid conflicts
	option mdns_base_port '8400'

# Example: OpenRouter cloud service with ephemeral key rotation
#config service
#	option name 'my-openrouter'
#	option deployment 'cloud'
#	option api_type 'openai'
#	option base_url 'https://openrouter.ai/api/v1'
#	option enabled '0'
#	option priority '10'
#	# Optional: custom port for mDNS advertisement (leave empty for auto-assign from 8400)
#	# If port is in use, service will fail to start
#	#option advertise_port '8400'
#	# REQUIRED: OpenRouter provisioning key (NOT a regular API key)
#	# Get at: https://openrouter.ai/settings/provisioning-keys
#	option api_key ''
#	# Enable ephemeral key rotation
#	option ephemeral_keys '1'
#	option key_endpoint 'https://openrouter.ai/api/v1/keys'
#	# Optional: spending limit per ephemeral key in USD (0 = no limit)
#	option spending_limit '0'
#	# Credential rotation interval in seconds
#	option rotation_interval '300'
#	# Credential expiration in seconds (must be > rotation_interval)
#	option expires_interval '600'

# Example: OpenAI cloud service (direct API key, no rotation)
#config service
#	option name 'my-openai'
#	option deployment 'cloud'
#	option api_type 'openai'
#	option base_url 'https://api.openai.com/v1'
#	option enabled '0'
#	option priority '20'
#	# REQUIRED: OpenAI API key
#	option api_key ''

# Example: DeepInfra cloud service
#config service
#	option name 'my-deepinfra'
#	option deployment 'cloud'
#	option api_type 'openai'
#	option base_url 'https://api.deepinfra.com/v1/openai'
#	option enabled '0'
#	option priority '40'
#	# REQUIRED: DeepInfra API key
#	option api_key ''

# Example: Ollama network service (local machine on LAN)
#config service
#	option name 'gaming-pc-ollama'
#	option deployment 'network'
#	option api_type 'ollama'
#	option base_url 'http://192.168.1.50:11434'
#	option enabled '0'
#	option priority '5'
#	option host '192.168.1.50'
#	option port '11434'

# Example: vLLM or other OpenAI-compatible network service
#config service
#	option name 'server-vllm'
#	option deployment 'network'
#	option api_type 'openai'
#	option base_url 'http://192.168.1.100:8000/v1'
