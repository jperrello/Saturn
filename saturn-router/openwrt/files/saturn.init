#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/tmp/saturn
CONFIG_DIR=/tmp/saturn.d
SERVICE_COUNT=0
CLOUD_PORT_OFFSET=0

is_port_in_use() {
	local port="$1"
	netstat -tuln 2>/dev/null | grep -q ":${port} " && return 0
	return 1
}

find_available_port() {
	local base_port="$1"
	local port="$base_port"
	local max_attempts=100
	local attempt=0

	while [ "$attempt" -lt "$max_attempts" ]; do
		if ! is_port_in_use "$port"; then
			echo "$port"
			return 0
		fi
		port=$((port + 1))
		attempt=$((attempt + 1))
	done

	logger -t saturn -p daemon.warn "Could not find available port starting from $base_port"
	echo "$base_port"
	return 1
}

validate_service() {
	local section="$1"
	local deployment api_type base_url api_key host port

	config_get deployment "$section" deployment ""
	config_get api_type "$section" api_type ""
	config_get base_url "$section" base_url ""
	
	if [ -z "$deployment" ]; then
		logger -t saturn -p daemon.warn "Service '$section': missing deployment type, skipping"
		return 1
	fi
	
	if [ -z "$api_type" ]; then
		logger -t saturn -p daemon.warn "Service '$section': missing api_type, skipping"
		return 1
	fi
	
	if [ -z "$base_url" ]; then
		logger -t saturn -p daemon.warn "Service '$section': missing base_url, skipping"
		return 1
	fi

	if [ "$deployment" = "cloud" ]; then
		config_get api_key "$section" api_key ""
		if [ -z "$api_key" ]; then
			logger -t saturn -p daemon.warn "Service '$section' (cloud): missing api_key, skipping"
			return 1
		fi
	elif [ "$deployment" = "network" ]; then
		config_get host "$section" host ""
		config_get port "$section" port ""
		if [ -z "$host" ]; then
			logger -t saturn -p daemon.warn "Service '$section' (network): missing host, skipping"
			return 1
		fi
		if [ -z "$port" ]; then
			logger -t saturn -p daemon.warn "Service '$section' (network): missing port, skipping"
			return 1
		fi
	else
		logger -t saturn -p daemon.warn "Service '$section': invalid deployment type '$deployment', skipping"
		return 1
	fi

	return 0
}

generate_config() {
	local section="$1"
	local name deployment api_type base_url priority
	local api_key host port custom_advertise_port
	local ephemeral_keys key_endpoint rotation expires spending_limit
	local mdns_base_port advertise_port

	config_get name "$section" name ""
	config_get deployment "$section" deployment ""
	config_get api_type "$section" api_type ""
	config_get base_url "$section" base_url ""
	config_get priority "$section" priority 10

	config_get api_key "$section" api_key ""
	config_get host "$section" host ""
	config_get port "$section" port ""
	config_get custom_advertise_port "$section" advertise_port ""

	config_get ephemeral_keys "$section" ephemeral_keys 0
	config_get key_endpoint "$section" key_endpoint ""
	config_get rotation "$section" rotation_interval 300
	config_get expires "$section" expires_interval 600
	config_get spending_limit "$section" spending_limit 0

	config_get mdns_base_port main mdns_base_port 8400

	if [ -z "$name" ]; then
		name="$(cat /proc/sys/kernel/hostname)-$api_type"
	fi

	if [ "$deployment" = "cloud" ]; then
		if [ -n "$custom_advertise_port" ]; then
			if is_port_in_use "$custom_advertise_port"; then
				logger -t saturn -p daemon.err "Service '$name': port $custom_advertise_port is already in use"
				return 1
			fi
			advertise_port="$custom_advertise_port"
		else
			local target_port=$((mdns_base_port + CLOUD_PORT_OFFSET))
			advertise_port=$(find_available_port "$target_port")
			CLOUD_PORT_OFFSET=$((CLOUD_PORT_OFFSET + 1))
		fi
	else
		advertise_port="$port"
	fi

	logger -t saturn -p daemon.debug "Service '$name' will advertise on port $advertise_port"

	local config_file="$CONFIG_DIR/${section}.json"
	
	local host_json=""
	local port_json=""
	local key_endpoint_json=""
	
	if [ -n "$host" ]; then
		host_json="\"host\": \"$host\","
	fi
	if [ -n "$port" ]; then
		port_json="\"port\": $port,"
	fi
	if [ -n "$key_endpoint" ]; then
		key_endpoint_json="\"key_endpoint\": \"$key_endpoint\","
	fi

	cat > "$config_file" <<EOF
{
  "name": "$name",
  "priority": $priority,
  "advertise_port": $advertise_port,
  "service": {
    "deployment": "$deployment",
    "api_type": "$api_type",
    "base_url": "$base_url",
    "api_key": $([ -n "$api_key" ] && echo "\"$api_key\"" || echo "null"),
    $host_json
    $port_json
    "ephemeral_keys": $([ "$ephemeral_keys" = "1" ] && echo "true" || echo "false"),
    $key_endpoint_json
    "rotation_seconds": $rotation,
    "expires_seconds": $expires,
    "spending_limit": $spending_limit
  }
}
EOF
	chmod 600 "$config_file"
	echo "$config_file"
}

start_service_instance() {
	local section="$1"
	local name enabled config_file

	config_get name "$section" name "$section"
	config_get enabled "$section" enabled 0

	[ "$enabled" = "0" ] && {
		logger -t saturn -p daemon.debug "Service '$name' disabled, skipping"
		return 0
	}

	validate_service "$section" || return 0
	config_file=$(generate_config "$section")

	logger -t saturn -p daemon.info "Starting service '$name'"

	procd_open_instance "saturn-$section"
	procd_set_param command "$PROG" --config "$config_file"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/saturn
	procd_set_param pidfile "/var/run/saturn-${section}.pid"
	procd_set_param env RUST_LOG=info
	procd_close_instance

	SERVICE_COUNT=$((SERVICE_COUNT + 1))
}

start_service() {
	local enabled

	config_load saturn
	config_get enabled main enabled 1

	[ "$enabled" = "0" ] && {
		logger -t saturn -p daemon.info "Saturn disabled in config"
		return 0
	}

	mkdir -p "$CONFIG_DIR"
	chmod 700 "$CONFIG_DIR"

	SERVICE_COUNT=0
	config_foreach start_service_instance service

	if [ "$SERVICE_COUNT" = "0" ]; then
		logger -t saturn -p daemon.warn "No valid services configured"
		logger -t saturn -p daemon.info "Configure a service with: uci add saturn service"
	else
		logger -t saturn -p daemon.info "Started $SERVICE_COUNT Saturn service(s)"
	fi
}

stop_service() {
	logger -t saturn -p daemon.info "Stopping all Saturn services"
	rm -rf "$CONFIG_DIR"
}

reload_service() {
	logger -t saturn -p daemon.info "Reloading Saturn services"
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "saturn"
}

status() {
	local count=0
	local running=""
	local stopped=""

	for pidfile in /var/run/saturn-*.pid; do
		[ -f "$pidfile" ] || continue
		local name=$(basename "$pidfile" .pid | sed 's/saturn-//')
		local pid=$(cat "$pidfile" 2>/dev/null)
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			running="$running $name(PID:$pid)"
			count=$((count + 1))
		else
			stopped="$stopped $name"
		fi
	done

	if [ "$count" -gt 0 ]; then
		echo "Saturn services running:$running"
	fi
	if [ -n "$stopped" ]; then
		echo "Saturn services stopped:$stopped"
	fi
	if [ "$count" = "0" ] && [ -z "$stopped" ]; then
		echo "No Saturn services running"
	fi
	return 0
}

print_service() {
	local section="$1"
	local name deployment api_type base_url enabled priority api_key host port

	config_get name "$section" name "$section"
	config_get deployment "$section" deployment ""
	config_get api_type "$section" api_type ""
	config_get base_url "$section" base_url ""
	config_get enabled "$section" enabled 0
	config_get priority "$section" priority 10

	echo "  [$section] $name:"
	echo "    Deployment: $deployment"
	echo "    API Type: $api_type"
	echo "    Base URL: $base_url"
	echo "    Enabled: $enabled"
	echo "    Priority: $priority"

	if [ "$deployment" = "cloud" ]; then
		config_get api_key "$section" api_key ""
		local key_len="${#api_key}"
		if [ "$key_len" -gt 0 ]; then
			echo "    API Key: (${key_len} chars)"
		else
			echo "    API Key: (not set)"
		fi
	elif [ "$deployment" = "network" ]; then
		config_get host "$section" host ""
		config_get port "$section" port ""
		echo "    Host: $host"
		echo "    Port: $port"
	fi
}

show_config() {
	local enabled health_interval

	config_load saturn
	config_get enabled main enabled 1
	config_get health_interval main health_interval 30

	echo "=== Saturn Configuration ==="
	echo "Enabled: $enabled"
	echo "Health Check Interval: ${health_interval}s"
	echo ""
	echo "=== Services ==="

	config_foreach print_service service
}

boot() {
	start "$@"
}

EXTRA_COMMANDS="status show_config"
EXTRA_HELP="	status		Show running status of all services
	show_config	Display current configuration"
