# Saturn — example environment file.
# Copy to .env and fill in for the cloud backends you intend to run.
# `saturn ollama` does not require any of these.

# OpenRouter (https://openrouter.ai/keys)
# Used by: saturn openrouter
OPENROUTER_API_KEY=

# OpenRouter provisioning key (only needed to mint runtime sub-keys)
OPENROUTER_PROVISIONING_KEY=

# DeepInfra (https://deepinfra.com/dash/api_keys)
# Used by: saturn deepinfra
DEEPINFRA_API_KEY=
