[Unit]
Description=Saturn Agent Daemon - Zero-configuration AI agent discovery
Documentation=https://github.com/joeyperrello/saturn
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=saturn
Group=saturn
ExecStart=/usr/local/bin/saturnd
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=saturnd

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# Allow network access for mDNS
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_BROADCAST CAP_NET_RAW
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_BROADCAST CAP_NET_RAW

[Install]
WantedBy=multi-user.target
