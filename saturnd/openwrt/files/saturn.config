# Saturn Beacon Configuration
# Zero-configuration AI service discovery for local networks
#
# Quick Start:
#   1. Set your API key:
#      uci set saturn.deepinfra.api_key='YOUR_DEEPINFRA_API_KEY'
#      uci commit saturn
#
#   2. Start the service:
#      /etc/init.d/saturn start
#
# All devices on your network will automatically discover this beacon
# via mDNS and receive ephemeral credentials for AI API access.

config saturn 'main'
	# Enable/disable the beacon service
	option enabled '1'

	# Beacon name (appears in mDNS announcements)
	# Leave empty to use hostname-beacon
	option name ''

	# Default priority for mDNS (lower = higher priority)
	# When multiple beacons exist, clients prefer lower numbers
	option priority '10'

	# Credential rotation interval in seconds
	# Ephemeral JWTs are regenerated at this interval
	option rotation_interval '300'

	# Credential expiration in seconds
	# Should be > rotation_interval to ensure overlap
	option expires_interval '600'

# DeepInfra Provider
# Uses scoped JWT authentication with automatic rotation
# Get your API key at: https://deepinfra.com/dash/api_keys
config provider 'deepinfra'
	option enabled '1'
	# REQUIRED: Your DeepInfra API key
	# Set via: uci set saturn.deepinfra.api_key='YOUR_KEY'
	option api_key ''
	# Provider-specific priority (overrides main priority)
	# option priority '10'
	# Provider-specific rotation interval
	# option rotation_interval '300'
	# Provider-specific expiration interval
	# option expires_interval '600'

# OpenRouter Provider (Phase E3 - not yet implemented)
# Uses key provisioning API for ephemeral credentials
# Get your API key at: https://openrouter.ai/keys
#config provider 'openrouter'
#	option enabled '0'
#	option api_key ''
#	option priority '20'

# Anthropic Provider (Phase E3 - not yet implemented)
# Direct API key pass-through (no rotation)
# Get your API key at: https://console.anthropic.com/
#config provider 'anthropic'
#	option enabled '0'
#	option api_key ''
#	option priority '30'
